# 数据库（默认 SQLite，零配置；可选 MySQL）
DATABASE_URL=sqlite:///./kb.db
# DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/kb_db?charset=utf8mb4

# JWT
JWT_SECRET_KEY=please-change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=*

# 默认账号
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_EDITOR_USERNAME=editor
DEFAULT_EDITOR_PASSWORD=editor123

# 智谱 GLM（问答生成 LLM）https://open.bigmodel.cn
# Z.ai Coding Plan 的 key 则改为：GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_API_KEY=你的key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
# 推理模型思考开关：disabled 降低问答延迟，enabled 回答更深入但更慢
LLM_THINKING=disabled

# 硅基流动（BGE 向量嵌入，用于 RAG 检索）https://siliconflow.cn
SILICONFLOW_API_KEY=sk-你的key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# RAG 检索参数
RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50
HYBRID_FETCH_K=10
# 重排序模型（置空则跳过重排序，仅用 RRF 融合结果）
RERANK_MODEL=BAAI/bge-reranker-v2-m3
